# ============================================================================
# UNIVERSAL MULTI-PLATFORM SOCIAL MEDIA AUTO-PUBLISHER (.env.example)
# Zuari / Danger.Labs • FollowDesk Seamless Social & Community Engine
# ============================================================================
# Copy this file to `.env` and fill in the platforms you want to activate.
# Never commit your real `.env` file to version control!

SOCIAL_BRAND_NAME="Zuari / Danger.Labs • FollowDesk"
SOCIAL_DEFAULT_URL="https://github.com/danger-labs/followdesk"

# Required to use the local encrypted credential vault. Generate a unique random
# value of at least 32 characters and keep it outside the database/source tree.
FOLLOWDESK_VAULT_KEY=""

# ----------------------------------------------------------------------------
# 1. DISCORD (Instant / 30-second setup — Zero API Approval Needed)
# Setup: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# ----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""
DISCORD_BOT_USERNAME="Zuari Release Bot"
DISCORD_BOT_AVATAR_URL=""

# ----------------------------------------------------------------------------
# 2. TELEGRAM (Instant / 1-minute setup — Free Bot API)
# Setup: Message @BotFather on Telegram -> /newbot -> Copy Token.
# Add bot as Admin to your channel or group and set @channel_username or chat ID.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_PARSE_MODE="HTML"

# ----------------------------------------------------------------------------
# 3. INSTAGRAM / THREADS / FACEBOOK (via Buffer API or Direct Meta Graph API)
# Option A: Buffer API (automatically syndicates to IG, Threads, and FB)
# Option B: Direct Meta Graph API (Instagram Business Account ID + Page Token)
# ----------------------------------------------------------------------------
BUFFER_ACCESS_TOKEN=""
BUFFER_PROFILE_IDS=""

META_ACCESS_TOKEN=""
META_IG_ACCOUNT_ID=""
META_PAGE_ID=""
META_APP_ID=""
META_APP_SECRET=""
# Must match the local API callback entered in the Meta app settings, for example:
# http://localhost:4174/api/social/meta/callback
META_REDIRECT_URI="http://127.0.0.1:4174/api/social/meta/callback"
# Optional; change when upgrading your Meta app to a newer supported Graph API version.
META_GRAPH_API_VERSION="v27.0"

# ----------------------------------------------------------------------------
# 4. REDDIT COMMUNITY (Script OAuth2 App — Subreddit Auto-Poster)
# Setup: https://www.reddit.com/prefs/apps -> Create App (select "script")
# ----------------------------------------------------------------------------
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
REDDIT_USER_AGENT="ZuariSocialPublisher/1.0 (by /u/your_reddit_username)"
REDDIT_SUBREDDIT="opensource"

# ----------------------------------------------------------------------------
# 5. TWITTER / X (REST API v2 + v1.1 Media Upload)
# Setup: https://developer.x.com -> Project App -> Keys and Tokens (Read & Write)
# ----------------------------------------------------------------------------
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
TWITTER_BEARER_TOKEN=""

# ----------------------------------------------------------------------------
# 6. LINKEDIN (versioned REST Posts API)
# Setup: https://www.linkedin.com/developers/ -> OAuth2 Token with w_member_social
# Author URN format: urn:li:person:XXXX or urn:li:organization:XXXX
# ----------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""
LINKEDIN_VERSION="202610"

# ----------------------------------------------------------------------------
# 7. GITHUB RELEASES (Built-in via GitHub Actions or Personal Access Token)
# Repository format: owner/repo (e.g., danger-labs/followdesk)
# ----------------------------------------------------------------------------
GITHUB_TOKEN=""
GITHUB_REPOSITORY="danger-labs/followdesk"
GITHUB_RELEASE_DRAFT="false"
GITHUB_RELEASE_PRERELEASE="false"

# ----------------------------------------------------------------------------
# OPTIONAL TEXT-ONLY AI (Google Gemini API)
# Free-tier prompts may be used to improve Google's products; never send confidential data.
# Create a key at https://aistudio.google.com/api-keys. Quotas and free access can change.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
