{
  "name": "followdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit -p src/tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "branding:assets": "node scripts/branding/generate-assets.mjs",
    "app-art:assets": "node scripts/uiux/generate-mini-app-art.mjs",
    "test:branding": "node --test scripts/branding/generate-assets.test.mjs",
    "test:app-art": "node --test scripts/uiux/generate-mini-app-art.test.mjs",
    "assets:validate": "node scripts/assets/validate-catalog.mjs",
    "test:assets": "node --test scripts/assets/catalog-validator.test.mjs",
    "test": "npm run test:all",
    "test:backend": "node --test server/*.test.mjs",
    "test:runtime": "node --test scripts/runtime/runtime.test.mjs",
    "test:automation": "node --test server/automation/*.test.mjs",
    "test:android": "node --test server/android/*.test.mjs",
    "test:domain": "node --experimental-strip-types --test test/domain.test.mjs test/smart-unfollow.test.mjs test/copy-and-intent.test.mjs test/worker-gateway.test.mjs",
    "test:app-navigation": "node --experimental-strip-types --test test/app-navigation.test.mjs",
    "test:extension": "node --test test/extension.test.mjs test/background-handlers.test.mjs test/extension-optimizations.test.mjs test/visual-bot-next-level.test.mjs",
    "test:adapters": "node --test test/adapters-dispatch.test.mjs test/adapters-dispatch-live.test.mjs",
    "test:stress": "node --test test/stress.test.mjs",
    "test:dev-tools": "node --test scripts/check-file-size.test.mjs scripts/monolith-audit.test.mjs scripts/repo-map.test.mjs scripts/find-docs.test.mjs scripts/branding/generate-assets.test.mjs scripts/uiux/check-plan.test.mjs scripts/uiux/generate-mini-app-art.test.mjs scripts/agent-eval/harness-core.test.mjs",
    "launch": "node auto-launch.mjs",
    "diagnose": "node scripts/diagnostics.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:file-size:report": "node scripts/check-file-size.mjs --verbose",
    "monolith:audit": "node scripts/monolith-audit.mjs",
    "repo:map": "node scripts/repo-map.mjs",
    "modularity:audit": "npm run monolith:audit && npm run repo:map",
    "docs:find": "node scripts/find-docs.mjs",
    "docs:audit": "node scripts/docs-audit.mjs",
    "docs:split": "node scripts/split-doc.mjs",
    "tasks": "node scripts/task-status.mjs",
    "tasks:status": "node scripts/task-status.mjs",
    "cli-anything": "node --experimental-strip-types scripts/cli-anything/socialkiller-cli.ts",
    "dev:doctor": "node --experimental-strip-types scripts/dev-supervisor.ts",
    "dev:visual-bot": "node --experimental-strip-types scripts/cli-anything/socialkiller-cli.ts visual-bot",
    "eval:agents": "node --experimental-strip-types scripts/agent-eval/run-evals.mjs",
    "planning:check": "npm run uiux:check && npm run docs:audit -- --stale-days 180 && npm run modularity:plan",
    "modularity:plan": "node scripts/modularity-plan.mjs",
    "uiux:check": "node scripts/uiux/check-plan.mjs",
    "uiux:hygiene": "node scripts/uiux/ui-hygiene-check.mjs",
    "verify": "npm run check:file-size && npm run build && npm test",
    "ports": "node -e \"import('./scripts/port-arbiter.mjs').then(async m => console.log('Port 5173:', await m.isPortActive(5173), 'Port 5199:', await m.isPortActive(5199), 'Port 4174:', await m.isPortActive(4174)))\"",
    "test:all": "node --test server/*.test.mjs && npm run test:runtime && npm run test:automation && npm run test:android && npm run test:assets && npm run test:domain && npm run test:app-navigation && npm run test:extension && npm run test:adapters && node --experimental-strip-types --test test/social-publisher.test.mjs && npm run test:stress && npm run test:dev-tools && npm run type-check",
    "test:watch": "node --watch --test server/*.test.mjs test/extension.test.mjs test/background-handlers.test.mjs",
    "start": "node auto-launch.mjs",
    "start:all": "node auto-launch.mjs",
    "dev": "node auto-launch.mjs",
    "dev:quick": "vite --host 127.0.0.1",
    "dev:backend": "node --watch server.mjs",
    "backend": "node server.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "social:broadcast": "node --experimental-strip-types scripts/social/index.ts",
    "social:dry-run": "node --experimental-strip-types scripts/social/index.ts --dry-run",
    "social:status": "node --experimental-strip-types scripts/social/index.ts --status",
    "test:social": "node --experimental-strip-types --test test/social-publisher.test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "android:open": "cap open android",
    "android:run": "cap run android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@formkit/auto-animate": "^0.10.2",
    "@primevue/themes": "^4.5.4",
    "@zuari/dom": "file:vendor/zuari/zuari-dom-0.1.0.tgz",
    "@zuari/glyphs": "file:vendor/zuari/zuari-glyphs-0.1.0.tgz",
    "@zuari/headless": "file:vendor/zuari/zuari-headless-0.1.0.tgz",
    "@zuari/recipes": "file:vendor/zuari/zuari-recipes-0.1.0.tgz",
    "@zuari/signals": "file:vendor/zuari/zuari-signals-0.1.0.tgz",
    "@zuari/ui": "file:vendor/zuari/zuari-ui-0.1.0.tgz",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^1.0.0",
    "primevue": "^4.5.5",
    "reka-ui": "^2.11.0",
    "sass": "^1.105.1",
    "vue-sonner": "^2.0.9"
  }
}
